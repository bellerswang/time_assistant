# Firebase Admin authentication
FIREBASE_PROJECT_ID=mercurial-weft-455321-v6
ALLOWED_FIREBASE_UID=replace-with-your-firebase-uid

# Used only by the local 07:30 email workflow client.
WORKFLOW_API_KEY=replace-with-a-long-random-secret
WORKFLOW_API_URL=https://voice-assistant-1090997558704.europe-west2.run.app

# Production browser origins. Add localhost only for local development.
